<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_configurable" model="ir.ui.view">
        <field name="name">sale.order.form.configurable</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="show_lines"
                    icon="fa-list"
                >
                    <field string="Lines" name="order_line_count" widget="statinfo" />
                </button>
            </div>
            <xpath
                expr="//page[@name='order_lines']//list"
                position="attributes"
            >
                <attribute name="class">sale_order_line_tree_view</attribute>
            </xpath>
            <xpath
                expr="//page[@name='order_lines']//list/field[@name='product_template_id']"
                position="after"
            >
                <button
                    name="action_show_product_config"
                    class="fa fa-gear"
                    type="object"
                    title="Info"
                    invisible="product_config_id == False"
                />
                <field name="product_config_id" column_invisible="1" />
                <field name="product_config_id_name" optional="hidden" />
                <field name="product_config_ids" column_invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
